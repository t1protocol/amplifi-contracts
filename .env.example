# AmplifiLendingPool — Polygon mainnet deploy
# Copy to .env, fill in OWNER_ADDRESS + RPC + key, then run:
#   source .env
#   forge script script/Deploy.s.sol --rpc-url $POLYGON_RPC_URL --private-key $PRIVATE_KEY --broadcast

# RPC + signer (DO NOT COMMIT)
POLYGON_RPC_URL=
PRIVATE_KEY=

# Required: deployer EOA. After deploy, call transferOwnership(<final owner>) and
# have the final owner accept via acceptOwnership() (Ownable2Step).
OWNER_ADDRESS=

# Defaults below match Polygon mainnet + the operator/fund key already in use.
# Override only if deploying somewhere else.
UNDERLYING_ADDRESS=0xC011a7E12a19f7B1f670d46F03B03f3342E82DFB
TEE_OPERATOR_ADDRESS=0xAA270BeAC402474A3eDF164C51CdAD9597f01707
FUND_ACCOUNT_ADDRESS=0xAA270BeAC402474A3eDF164C51CdAD9597f01707

# Rate model: 20% base, 200% kink rate, 1000% max, 85% kink utilization.
BASE_RATE_BPS=2000
KINK_UTILIZATION_BPS=8500
KINK_RATE_BPS=20000
MAX_RATE_BPS=100000

# ── Robinhood Chain (chain id 4663), the Juiced USDG pool ─────────────────────
# Same Deploy.s.sol, different asset and operator. The share token names itself
# after the asset ("aUSDG", 6 decimals). The operator is Juiced's treasury EOA,
# the one address allowed to call borrow(); the owner is the same as for the
# Polygon pools. Uncomment to use.
#   source .env
#   forge script script/Deploy.s.sol --rpc-url robinhood --private-key $PRIVATE_KEY --broadcast
# ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# UNDERLYING_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# TEE_OPERATOR_ADDRESS=<juiced treasury EOA>
